{
  "entities": {
    "Applicant": {
      "title": "Applicant",
      "description": "Event participant registration record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 15 },
        "org": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["남성", "여성", "선택 안 함"] },
        "consent": { "type": "boolean" },
        "consentAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["접수", "확인", "당첨", "취소"] },
        "memo": { "type": "string", "maxLength": 200 },
        "drawnAt": { "type": "string" }
      },
      "required": ["name", "phone", "email", "gender", "consent", "submittedAt", "status"]
    },
    "EventConfig": {
      "title": "EventConfig",
      "description": "Event global configuration and settings",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "eventDate": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "maxCapacity": { "type": "number" },
        "isOpen": { "type": "boolean" },
        "organizer": { "type": "string", "maxLength": 100 },
        "contactEmail": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "maxCapacity", "isOpen"]
    }
  },
  "firestore": {
    "/applicants/{applicantId}": {
      "schema": "Applicant",
      "description": "Registered event attendees"
    },
    "/config/{configId}": {
      "schema": "EventConfig",
      "description": "Event global configuration and metadata"
    }
  }
}
